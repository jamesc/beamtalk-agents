// Tests for AgentError and the shared displayString it gives the
// domain errors (CodexError, ClaudeError) that subclass it.

TestCase subclass: AgentErrorTest

  testBaseDisplayStringWithNoDetail =>
    err := AgentError new: #{#kind => "some_kind"}
    self assert: err displayString equals: "AgentError(some_kind)"

  testBaseDisplayStringWithDetail =>
    err := AgentError new: #{#kind => "some_kind", #detail => "extra info"}
    self assert: err displayString equals: "AgentError(some_kind): extra info"

  testCodexErrorDisplayString =>
    err := CodexError notFound: "no thread"
    self assert: err displayString equals: "CodexError(not_found): no thread"

  testCodexErrorWithoutDetail =>
    err := CodexError turnTimeout
    self assert: err displayString equals: "CodexError(turn_timeout)"

  testClaudeErrorDisplayString =>
    err := ClaudeError notFound: "no binary"
    self assert: err displayString equals: "ClaudeError(not_found): no binary"

  testClaudeErrorWithoutDetail =>
    err := ClaudeError turnTimeout
    self assert: err displayString equals: "ClaudeError(turn_timeout)"
