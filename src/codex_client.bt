/// CodexClient — manages a codex app-server subprocess over stdio.
/// Handles JSON-RPC protocol, session startup handshake,
/// request/response matching, and turn streaming.
///
/// Uses helper methods (launch, sendRequest:params:, etc.) for protocol steps.
///
/// Config is a plain Dictionary (no host-app config coupling, so this
/// file moves between packages unchanged). Keys, both optional:
/// "command" (default "codex app-server"), "readTimeoutMs" (default
/// 5000).
typed Actor subclass: CodexClient
  late state: proc :: Subprocess
  state: nextId :: Integer
  state: workspacePath :: String
  state: command :: String = "codex app-server"
  state: readTimeoutMs :: Integer = 5000
  state: onEvent :: Block(Dictionary, Object) | Nil = nil

  /// Spawns a new CodexClient actor bound to the given workspace directory.
  class start: workspacePath :: String config: config :: Dictionary onEvent: callback :: Block(Dictionary, Object) | Nil -> CodexClient =>
    self
      spawnWith: #{
        #workspacePath => workspacePath,
        #command => (config at: "command" ifAbsent: ["codex app-server"]),
        #readTimeoutMs => (config at: "readTimeoutMs" ifAbsent: [5000]),
        #onEvent => callback,
        #nextId => 1
      }

  // --- Token and rate-limit extraction ---

  /// Extracts token usage counters from a codex event message, or nil.
  class extractUsage: msg :: Dictionary -> Dictionary | Nil =>
    // Look for token usage in common payload shapes
    params := msg at: "params" ifAbsent: [#{}]
    // Try tokenUsage.total (codex format), then total_token_usage, then usage
    tokenUsage := params at: "tokenUsage" ifAbsent: [nil]
    usage := tokenUsage match: [
      d :: Dictionary -> (d at: "total" ifAbsent: [nil]);
      _ -> nil
    ]
    usage := usage ifNil: [
      params at: "total_token_usage" ifAbsent: [
        params at: "usage" ifAbsent: [nil]
      ]
    ]
    usage match: [
      u :: Dictionary -> #{
        "input" => (u at: "input_tokens" ifAbsent: [
          u at: "inputTokens" ifAbsent: [0]
        ]),
        "output" => (u at: "output_tokens" ifAbsent: [
          u at: "outputTokens" ifAbsent: [0]
        ]),
        "total" => (u at: "total_tokens" ifAbsent: [
          u at: "totalTokens" ifAbsent: [0]
        ])
      };
      _ -> nil
    ]

  /// Extracts rate limit info from a codex event message, or nil.
  class extractRateLimits: msg :: Dictionary -> Dictionary | Nil =>
    params := msg at: "params" ifAbsent: [#{}]
    params at: "rate_limits" ifAbsent: [params at: "rateLimits" ifAbsent: [nil]]

  // --- Subprocess lifecycle ---
  terminate: _reason :: Object -> Nil => self stopProcess

  stopProcess -> Nil =>
    Logger debug: "codex process stopping"
    (self hasField: #proc)
      ifTrue: [
        self.proc close
        self.proc stop
        self clearField: #proc
      ]
    nil

  // --- Subprocess launch ---

  /// Opens the codex subprocess and sets self.proc.
  launch -> Result(Nil, CodexError) =>
    procResult := [
      Subprocess
        open: "/bin/bash"
        args: #("-lc", self.command)
        dir: self.workspacePath
    ]
      on: Error
      do: [:e |
        Logger error: "codex launch failed" metadata: #{"error" => e message}
        ^Result error: (CodexError notFound: e message)
      ]
    procResult isError
      ifTrue: [
        Logger error: "codex launch error" metadata: #{
          "error" => procResult error displayString
        }
        ^Result error: (CodexError notFound: procResult error displayString)
      ]
    self.proc := procResult unwrap
    Logger info: "codex process launched"
    Result ok: nil

  // --- JSON-RPC helpers ---

  /// Writes a JSON-RPC message to the subprocess.
  sendJson: msg :: Dictionary -> Nil =>
    line := Json generate: msg
    self.proc writeLine: line

  /// Allocates a request ID, sends the request, and returns the ID.
  sendRequest: method :: String params: params :: Dictionary -> Integer =>
    id := self.nextId
    self.nextId := self.nextId + 1
    msg := #{"id" => id, "method" => method, "params" => params}
    Logger debug: "codex >> " ++ method ++ " (id=" ++ id displayString ++ ")"
    self sendJson: msg
    id

  /// Sends a notification (no id, no response expected).
  sendNotification: method :: String params: params :: Dictionary -> Nil =>
    msg := #{"method" => method, "params" => params}
    Logger debug: "codex >> " ++ method ++ " (notification)"
    self sendJson: msg

  // --- Response reading (no state mutation, self-recursion is safe) ---
  readResponse: expectedId :: Integer timeout: timeoutMs :: Integer -> Result(Dictionary, CodexError) =>
    deadline := (DateTime now asTimestamp * 1000) + timeoutMs
    self readUntilResponse: expectedId deadline: deadline

  readUntilResponse: expectedId :: Integer deadline: deadline :: Integer -> Result(Dictionary, CodexError) =>
    remaining := deadline - (DateTime now asTimestamp * 1000)
    remaining <= 0
      ifTrue: [
        Logger warn: "codex response timeout" metadata: #{
          "id" => expectedId displayString
        }
        ^Result error: (CodexError responseTimeout: expectedId)
      ]
    readTimeout := remaining > 1000 ifTrue: [1000] ifFalse: [remaining]

    line := self.proc readLine: readTimeout
    line isNil
      ifTrue: [
        exitCode := self.proc exitCode
        exitCode isNil
          ifFalse: [
            Logger warn: "codex process exited" metadata: #{
              "exit_code" => exitCode displayString
            }
            ^Result error: (CodexError portExit: exitCode)
          ]
        ^self readUntilResponse: expectedId deadline: deadline
      ]
    // BT-4172: readLine: answers bytes; convert for the log.
    Logger debug: "codex << " ++ line asStringUnchecked

    ([Json parse: line] on: Error do: [:e | Result error: e message])
      ifOk: [:parsedMsg |
        msgId := parsedMsg at: "id" ifAbsent: [nil]
        msgId == expectedId ifTrue: [^Result ok: parsedMsg]
        // Notification or different response — emit as event
        method := parsedMsg at: "method" ifAbsent: ["?"]
        Logger debug: "codex event: " ++ method displayString
        self emitEvent: parsedMsg
        self readUntilResponse: expectedId deadline: deadline
      ]
      ifError: [:_e |
        Logger debug: "codex non-JSON line, skipping"
        self readUntilResponse: expectedId deadline: deadline
      ]

  // --- Session startup handshake ---

  /// Launches the subprocess and performs the initialize/thread-start handshake.
  startSession -> Result(Dictionary, AgentError) =>
    Logger info: "codex session starting" metadata: #{
      "workspace" => self.workspacePath,
      "command" => self.command
    }

    launchResult := self launch
    launchResult isError ifTrue: [^launchResult]

    readTimeout := self.readTimeoutMs

    // Step 1: initialize request
    initId := self
      sendRequest: "initialize"
      params: #{
        "clientInfo" => #{"name" => "symphony", "version" => "1.0"},
        "capabilities" => #{}
      }
    initResp := self readResponse: initId timeout: readTimeout
    initResp isError
      ifTrue: [
        Logger error: "codex initialize failed" metadata: #{
          "error" => initResp error displayString
        }
        self stopProcess
        ^Result error: (CodexError startupFailed: "initialize" detail: initResp error)
      ]
    Logger info: "codex initialized"

    // Step 2: initialized notification
    self sendNotification: "initialized" params: #{}

    // Step 3: thread/start request
    threadReqId := self sendRequest: "thread/start" params: #{
      "cwd" => self.workspacePath
    }
    threadResp := self readResponse: threadReqId timeout: readTimeout
    threadResp isError
      ifTrue: [
        Logger error: "codex thread/start failed" metadata: #{
          "error" => threadResp error displayString
        }
        self stopProcess
        ^Result error: (CodexError startupFailed: "thread/start" detail: threadResp error)
      ]

    // Extract thread ID from response
    threadResp
      map: [:threadData |
        threadResult := threadData at: "result" ifAbsent: [#{}]
        thread := threadResult at: "thread" ifAbsent: [#{}]
        tid := thread at: "id" ifAbsent: [nil]
        Logger info: "codex session ready" metadata: #{
          "threadId" => tid displayString
        }
        #{"threadId" => tid}
      ]

  // --- Turn management ---

  /// Timeout error in this backend's taxonomy (AgentBackend seam).
  turnTimeout -> AgentError => CodexError turnTimeout

  /// Sends a turn/start request with the given prompt and waits for acknowledgement.
  startTurn: threadId :: String prompt: prompt :: String title: title :: String -> Result(Dictionary, AgentError) =>
    Logger info: "codex turn starting" metadata: #{
      "title" => title,
      "prompt_length" => prompt length displayString
    }
    readTimeout := self.readTimeoutMs
    turnId := self
      sendRequest: "turn/start"
      params: #{
        "threadId" => threadId,
        "input" => #(#{"type" => "text", "text" => prompt}),
        "cwd" => self.workspacePath,
        "title" => title,
        "sandboxPolicy" => #{"type" => "dangerFullAccess"}
      }
    turnResp := self readResponse: turnId timeout: readTimeout
    turnResp isError
      ifTrue: [
        Logger error: "codex turn/start failed" metadata: #{
          "error" => turnResp error displayString
        }
        ^turnResp
      ]
    turnResp
      map: [:turnData |
        turnResult := turnData at: "result" ifAbsent: [#{}]
        turn := turnResult at: "turn" ifAbsent: [#{}]
        tuid := turn at: "id" ifAbsent: [nil]
        Logger info: "codex turn started" metadata: #{
          "turnId" => tuid displayString
        }
        #{"turnId" => tuid}
      ]

  /// Reads and processes the next stream event. Returns:
  /// - nil if no event yet (caller should call again)
  /// - Result ok: ... if turn completed
  /// - Result error: ... if turn failed/timed out
  streamStep -> Result(Dictionary, AgentError) | Nil =>
    line := self.proc readLine: 1000
    line isNil
      ifTrue: [
        exitCode := self.proc exitCode
        exitCode isNil
          ifFalse: [
            Logger warn: "codex process exited during stream" metadata: #{
              "exit_code" => exitCode displayString
            }
            ^Result error: (CodexError portExit: exitCode)
          ]
        ^nil  // No data yet, caller should retry
      ]
    // BT-4172: readLine: answers bytes; convert for the log.
    Logger debug: "codex << " ++ line asStringUnchecked

    ([
      Json parse: line
    ] on: Error do: [:e |
      Result error: e message
    ]) ifOk: [:msg | self handleStreamMessage: msg] ifError: [:_e | nil]

  handleStreamMessage: msg :: Dictionary -> Result(Dictionary, CodexError) | Nil =>
    method := msg at: "method" ifAbsent: [nil]
    method match: [
      "turn/completed" -> (self turnCompleted: msg);
      "turn/failed" -> (self turnFailed: msg);
      "turn/cancelled" -> (self turnCancelled: msg);
      // Approval requests — auto-approve all types
      "item/approval/request" -> (self autoApprove: msg);
      "item/commandExecution/requestApproval" -> (self autoApprove: msg);
      "item/fileChange/requestApproval" -> (self autoApprove: msg);
      "item/tool/requestUserInput" -> (self inputRequired: msg);
      "item/tool/call" -> (self rejectToolCall: msg);
      _ -> (self passThrough: msg method: method)
    ]

  /// Result for `turn/completed`.
  turnCompleted: msg :: Dictionary -> Result(Dictionary, CodexError) =>
    Logger info: "codex turn completed"
    self emitEvent: msg
    Result ok: #{"status" => "completed", "message" => msg}

  /// Error result for `turn/failed`.
  turnFailed: msg :: Dictionary -> Result(Dictionary, CodexError) =>
    Logger error: "codex turn failed" metadata: #{"method" => "turn/failed"}
    self emitEvent: msg
    Result error: (CodexError turnFailed: msg)

  /// Error result for `turn/cancelled`.
  turnCancelled: msg :: Dictionary -> Result(Dictionary, CodexError) =>
    Logger warn: "codex turn cancelled"
    self emitEvent: msg
    Result error: (CodexError turnCancelled: msg)

  /// Approves the request and continues streaming (nil).
  autoApprove: msg :: Dictionary -> Nil =>
    Logger debug: "codex auto-approving: " ++ (msg at: "method" ifAbsent: [
      nil
    ]) displayString
    self sendJson: #{
      "id" => (msg at: "id" ifAbsent: [nil]),
      "result" => #{"approved" => true}
    }
    self emitEvent: msg
    nil

  /// User input required — hard failure.
  inputRequired: msg :: Dictionary -> Result(Dictionary, CodexError) =>
    Logger warn: "codex requires user input, failing turn"
    self emitEvent: msg
    Result error: (CodexError turnInputRequired: msg)

  /// Unsupported tool call: answer it and continue streaming (nil).
  rejectToolCall: msg :: Dictionary -> Nil =>
    Logger warn: "codex unsupported tool call" metadata: #{
      "method" => "item/tool/call"
    }
    self
      sendJson: #{
        "id" => (msg at: "id" ifAbsent: [nil]),
        "result" => #{"success" => false, "error" => "unsupported_tool_call"}
      }
    self emitEvent: msg
    nil

  /// Any other message — log method and continue (nil).
  passThrough: msg :: Dictionary method: method :: Object -> Nil =>
    method isNil ifFalse: [
      Logger debug: "codex event: " ++ method displayString
    ]
    self emitEvent: msg
    nil

  // --- Event emission ---
  emitEvent: msg :: Dictionary -> Nil =>
    self.onEvent isNil
      ifFalse: [
        // Enrich with extracted usage and rate limits
        event := #{
          "raw" => msg,
          "method" => (msg at: "method" ifAbsent: [nil]),
          "usage" => (CodexClient extractUsage: msg),
          "rateLimits" => (CodexClient extractRateLimits: msg),
          "timestamp" => (DateTime now asTimestamp * 1000)
        }
        self.onEvent value: event
      ]
    nil
